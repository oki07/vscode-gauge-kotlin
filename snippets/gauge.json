{
  "Specification": {
    "prefix": "spec",
    "body": [
      "${1:Specification Heading}",
      "=====================",
      "Created by ${2:USER} on $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "",
      "This is an executable specification file which follows markdown syntax.",
      "Every heading in this file denotes a scenario. Every bulleted point denotes a step.",
      "",
      "Scenario Heading",
      "----------------",
      "$0"
    ],
    "description": "New Specification"
  },
  "Scenario": {
    "prefix": "sce",
    "body": [
      "${1:Scenario Heading}",
      "----------------",
      "* $0"
    ],
    "description": "New Scenario"
  },
  "Concept": {
    "prefix": "cpt",
    "body": [
      "Created by ${1:USER} on $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "",
      "This is a concept file with following syntax for each concept.",
      "# ${2:Concept Heading}",
      "* step1",
      "* step2",
      "$0"
    ],
    "description": "New Concept"
  },
  "Table with one column": {
    "prefix": "table:1",
    "body": [
      "|${1:HEADER}|",
      "|------|",
      "|${2:value}|",
      "|${3:value}$0|"
    ],
    "description": "table with 1 column"
  },
  "Table with two columns": {
    "prefix": "table:2",
    "body": [
      "|${1:HEADER}|${2:HEADER}|",
      "|------|------|",
      "|${3:value}|${4:value}|",
      "|${5:value}|${6:value}$0|"
    ],
    "description": "table with 2 columns"
  },
  "Table with three columns": {
    "prefix": "table:3",
    "body": [
      "|${1:HEADER}|${2:HEADER}|${3:HEADER}|",
      "|------|------|------|",
      "|${4:value}|${5:value}|${6:value}|",
      "|${7:value}|${8:value}|${9:value}$0|"
    ],
    "description": "table with 3 columns"
  },
  "Table with four columns": {
    "prefix": "table:4",
    "body": [
      "|${1:HEADER}|${2:HEADER}|${3:HEADER}|${4:HEADER}|",
      "|------|------|------|------|",
      "|${5:value}|${6:value}|${7:value}|${8:value}|",
      "|${9:value}|${10:value}|${11:value}|${12:value}$0|"
    ],
    "description": "table with 4 columns"
  },
  "Table with five columns": {
    "prefix": "table:5",
    "body": [
      "|${1:HEADER}|${2:HEADER}|${3:HEADER}|${4:HEADER}|${5:HEADER}|",
      "|------|------|------|------|------|",
      "|${6:value}|${7:value}|${8:value}|${9:value}|${10:value}|",
      "|${11:value}|${12:value}|${13:value}|${14:value}|${15:value}$0|"
    ],
    "description": "table with 5 columns"
  },
  "Table with six columns": {
    "prefix": "table:6",
    "body": [
      "|${1:HEADER}|${2:HEADER}|${3:HEADER}|${4:HEADER}|${5:HEADER}|${6:HEADER}|",
      "|------|------|------|------|------|------|",
      "|${7:value}|${8:value}|${9:value}|${10:value}|${11:value}|${12:value}|",
      "|${13:value}|${14:value}|${15:value}|${16:value}|${17:value}|${18:value}$0|"
    ],
    "description": "table with 6 columns"
  }
}
