{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gauge",
  "scopeName": "text.gauge",
  "fileTypes": [
    "spec",
    "cpt",
    "md"
  ],
  "patterns": [
    {
      "include": "#frontMatter"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#tableKeyword"
    },
    {
      "include": "#specHeading"
    },
    {
      "include": "#scenarioHeading"
    },
    {
      "include": "#step"
    },
    {
      "include": "#teardown"
    },
    {
      "include": "#table"
    },
    {
      "include": "#markdown"
    },
    {
      "include": "#fallbackComment"
    }
  ],
  "repository": {
    "frontMatter": {
      "name": "meta.frontmatter.markdown.gauge",
      "contentName": "meta.embedded.block.frontmatter",
      "begin": "\\A-{3}\\s*$",
      "while": "^(?!(-{3}|\\.{3})\\s*$)",
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "comments": {
      "name": "comment.line.double-slash.gauge",
      "match": "^\\s*//.*$"
    },
    "tags": {
      "name": "meta.tags.gauge",
      "begin": "(?i)^(\\s*)(tags)([ \\t\\f]?:)(\\s*)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.tags.gauge"
        },
        "3": {
          "name": "punctuation.separator.key-value.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": "[^,\\s][^,]*",
          "name": "entity.other.attribute-name.tag.gauge"
        },
        {
          "match": ",",
          "name": "punctuation.separator.sequence.gauge"
        }
      ]
    },
    "tableKeyword": {
      "name": "meta.table-file.gauge",
      "begin": "(?i)^(\\s*)(table)([ \\t\\f]?:)(\\s*)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.table.gauge"
        },
        "3": {
          "name": "punctuation.separator.key-value.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": "\\S.*",
          "name": "string.unquoted.table-file.gauge"
        }
      ]
    },
    "specHeading": {
      "patterns": [
        {
          "name": "markup.heading.spec.gauge",
          "begin": "^(\\s*)(#)(?!#)(\\s*)",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.heading.spec.gauge"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#dynamicArguments"
            }
          ]
        },
        {
          "name": "punctuation.definition.heading.spec.gauge",
          "match": "^=+$"
        }
      ]
    },
    "scenarioHeading": {
      "patterns": [
        {
          "name": "markup.heading.scenario.gauge",
          "match": "^\\s*##.*$"
        },
        {
          "name": "punctuation.definition.heading.scenario.gauge",
          "match": "^-+$"
        }
      ]
    },
    "conceptHeading": {
      "name": "markup.heading.concept.gauge",
      "begin": "^(\\s*)(#)(\\s*)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.heading.concept.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#dynamicArguments"
        }
      ]
    },
    "step": {
      "name": "meta.step.gauge",
      "begin": "^(\\s*)(\\*)(\\s*)",
      "beginCaptures": {
        "2": {
          "name": "keyword.operator.step.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#arguments"
        }
      ]
    },
    "teardown": {
      "name": "keyword.control.teardown.gauge",
      "match": "^[ \\t\\f]*___+[ \\t\\f]*$"
    },
    "table": {
      "patterns": [
        {
          "include": "#tableSeparator"
        },
        {
          "include": "#tableRow"
        }
      ]
    },
    "tableSeparator": {
      "name": "meta.table.separator.gauge",
      "begin": "^(\\s*\\|)(?=(?:\\s*-+\\s*\\|)+\\s*$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.table.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": "-+",
          "name": "punctuation.definition.table-separator.gauge"
        },
        {
          "match": "(?<!\\\\)\\|",
          "name": "punctuation.separator.table.gauge"
        }
      ]
    },
    "tableRow": {
      "name": "meta.table.row.gauge",
      "begin": "^(\\s*\\|)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.table.gauge"
        }
      },
      "end": "$",
      "patterns": [
        {
          "match": "(?<!\\\\)\\|",
          "name": "punctuation.separator.table.gauge"
        },
        {
          "match": "\\\\\\|",
          "name": "string.unquoted.table-cell.gauge"
        },
        {
          "include": "#tableArguments"
        },
        {
          "match": "[^|]+",
          "name": "string.unquoted.table-cell.gauge"
        }
      ]
    },
    "dynamicArguments": {
      "patterns": [
        {
          "name": "variable.parameter.dynamic.gauge",
          "match": "(?<!\\\\)(<)((?:\\\\[<>]|[^>\\n])*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.begin.gauge"
            },
            "3": {
              "name": "punctuation.definition.variable.end.gauge"
            }
          }
        }
      ]
    },
    "arguments": {
      "patterns": [
        {
          "name": "variable.parameter.dynamic.gauge",
          "match": "(?<!\\\\)(<)((?:\\\\[<>]|[^>\\n])*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.begin.gauge"
            },
            "3": {
              "name": "punctuation.definition.variable.end.gauge"
            }
          }
        },
        {
          "name": "string.quoted.double.argument.gauge",
          "begin": "(?<!\\\\)\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.gauge"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.gauge"
            }
          },
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.gauge"
            }
          ]
        }
      ]
    },
    "tableArguments": {
      "patterns": [
        {
          "name": "variable.parameter.dynamic.gauge",
          "match": "(?<!\\\\)(<)((?:\\\\[<>|]|[^>|\\n])*)(>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.begin.gauge"
            },
            "3": {
              "name": "punctuation.definition.variable.end.gauge"
            }
          }
        },
        {
          "include": "#arguments"
        }
      ]
    },
    "markdown": {
      "patterns": [
        {
          "include": "#markdownBlockquote"
        },
        {
          "include": "#markdownSeparator"
        },
        {
          "include": "#markdownKotlinFencedCode"
        },
        {
          "include": "#markdownCssFencedCode"
        },
        {
          "include": "#markdownBasicFencedCode"
        },
        {
          "include": "#markdownIniFencedCode"
        },
        {
          "include": "#markdownJavaFencedCode"
        },
        {
          "include": "#markdownLuaFencedCode"
        },
        {
          "include": "#markdownMakefileFencedCode"
        },
        {
          "include": "#markdownPerlFencedCode"
        },
        {
          "include": "#markdownRFencedCode"
        },
        {
          "include": "#markdownRubyFencedCode"
        },
        {
          "include": "#markdownPhpFencedCode"
        },
        {
          "include": "#markdownSqlFencedCode"
        },
        {
          "include": "#markdownVsNetFencedCode"
        },
        {
          "include": "#markdownXmlFencedCode"
        },
        {
          "include": "#markdownXslFencedCode"
        },
        {
          "include": "#markdownYamlFencedCode"
        },
        {
          "include": "#markdownDosbatchFencedCode"
        },
        {
          "include": "#markdownClojureFencedCode"
        },
        {
          "include": "#markdownCoffeeFencedCode"
        },
        {
          "include": "#markdownCFencedCode"
        },
        {
          "include": "#markdownCppFencedCode"
        },
        {
          "include": "#markdownDiffFencedCode"
        },
        {
          "include": "#markdownDockerfileFencedCode"
        },
        {
          "include": "#markdownGitCommitFencedCode"
        },
        {
          "include": "#markdownGitRebaseFencedCode"
        },
        {
          "include": "#markdownGoFencedCode"
        },
        {
          "include": "#markdownGroovyFencedCode"
        },
        {
          "include": "#markdownJadeFencedCode"
        },
        {
          "include": "#markdownJavaScriptFencedCode"
        },
        {
          "include": "#markdownJsRegexpFencedCode"
        },
        {
          "include": "#markdownJsonFencedCode"
        },
        {
          "include": "#markdownLessFencedCode"
        },
        {
          "include": "#markdownObjcFencedCode"
        },
        {
          "include": "#markdownScssFencedCode"
        },
        {
          "include": "#markdownPerl6FencedCode"
        },
        {
          "include": "#markdownPowershellFencedCode"
        },
        {
          "include": "#markdownPythonFencedCode"
        },
        {
          "include": "#markdownRegexpPythonFencedCode"
        },
        {
          "include": "#markdownRustFencedCode"
        },
        {
          "include": "#markdownScalaFencedCode"
        },
        {
          "include": "#markdownShellFencedCode"
        },
        {
          "include": "#markdownTypeScriptFencedCode"
        },
        {
          "include": "#markdownTsxFencedCode"
        },
        {
          "include": "#markdownCSharpFencedCode"
        },
        {
          "include": "#markdownFSharpFencedCode"
        },
        {
          "include": "#markdownFencedCode"
        },
        {
          "include": "#markdownLinkDefinition"
        },
        {
          "include": "#markdownHtmlBlock"
        },
        {
          "include": "#markdownList"
        },
        {
          "include": "#markdownInline"
        }
      ]
    },
    "markdownBlockquote": {
      "name": "markup.quote.markdown.gauge",
      "match": "^(>\\s?)",
      "captures": {
        "1": {
          "name": "punctuation.definition.blockquote.markdown.gauge"
        }
      }
    },
    "markdownSeparator": {
      "name": "meta.separator.markdown.gauge",
      "match": "^\\s{0,3}(?:-{3,}|\\*{3,}|_{3,})\\s*$"
    },
    "markdownKotlinFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "^((?:`{3,}|~{3,})\\s*(?:[Kk][Oo][Tt][Ll][Ii][Nn]|[Kk][Tt][Ss]?)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.kotlin",
      "patterns": [
        {
          "include": "source.kotlin"
        }
      ]
    },
    "markdownJavaFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:java|bsh)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.java",
      "patterns": [
        {
          "include": "source.java"
        }
      ]
    },
    "markdownJavaScriptFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:js|jsx|javascript|es6|mjs)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "markdownJsonFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:json|sublime-settings|sublime-menu|sublime-keymap|sublime-mousemap|sublime-theme|sublime-build|sublime-project|sublime-completions)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "markdownPythonFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:python|py|py3|rpy|pyw|cpy|SConstruct|Sconstruct|sconstruct|SConscript|gyp|gypi)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.python",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "markdownShellFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:shell|sh|bash|zsh|bashrc|bash_profile|bash_login|profile|bash_logout|.textmate_init)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.shellscript",
      "patterns": [
        {
          "include": "source.shell"
        }
      ]
    },
    "markdownYamlFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:yaml|yml)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.yaml",
      "patterns": [
        {
          "include": "source.yaml"
        }
      ]
    },
    "markdownFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "^((?:`{3,}|~{3,})(?:\\s*[A-Za-z0-9_-]+)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$"
    },
    "markdownLinkDefinition": {
      "name": "meta.link.reference.def.markdown.gauge",
      "match": "^\\s{0,3}\\[[^\\]\\n]+\\]:\\s*\\S.*$"
    },
    "markdownHtmlBlock": {
      "name": "text.html.markdown.gauge",
      "begin": "^\\s{0,3}</?[A-Za-z][^>]*>",
      "end": "$",
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "markdownInline": {
      "patterns": [
        {
          "include": "#markdownReferenceImage"
        },
        {
          "include": "#markdownImage"
        },
        {
          "include": "#markdownReferenceLink"
        },
        {
          "include": "#markdownLink"
        },
        {
          "include": "#markdownAutoLink"
        },
        {
          "match": "`[^`\\n]+`",
          "name": "markup.raw.inline.markdown.gauge"
        },
        {
          "match": "(?:\\*\\*|__)[^\\n]+?(?:\\*\\*|__)",
          "name": "markup.bold.markdown.gauge"
        },
        {
          "match": "(?:\\*|_)[^\\s\\n][^\\n]*?(?:\\*|_)",
          "name": "markup.italic.markdown.gauge"
        }
      ]
    },
    "markdownLink": {
      "name": "meta.link.inline.markdown.gauge",
      "match": "\\[[^\\]\\n]+\\]\\([^\\s)]+(?:\\s+\"[^\"]*\")?\\)"
    },
    "markdownImage": {
      "name": "meta.image.inline.markdown.gauge",
      "match": "!\\[[^\\]\\n]*\\]\\([^\\s)]+(?:\\s+\"[^\"]*\")?\\)"
    },
    "markdownReferenceLink": {
      "name": "meta.link.reference.markdown.gauge",
      "match": "\\[[^\\]\\n]+\\]\\s?\\[[^\\]\\n]*\\]"
    },
    "markdownReferenceImage": {
      "name": "meta.image.reference.markdown.gauge",
      "match": "!\\[[^\\]\\n]*\\]\\s?\\[[^\\]\\n]*\\]"
    },
    "markdownAutoLink": {
      "name": "meta.link.auto.markdown.gauge",
      "match": "<(?:https?://[^>\\s]+|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})>"
    },
    "markdownList": {
      "name": "markup.list.markdown.gauge",
      "match": "^\\s*((?:[-+*]|\\d+\\.)(?:\\s+))",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.begin.markdown.gauge"
        }
      }
    },
    "fallbackComment": {
      "name": "comment.line.gauge",
      "match": "^\\s*\\S.*$"
    },
    "markdownCssFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:css|css.erb)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.css",
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "markdownBasicFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:html|htm|shtml|xhtml|inc|tmpl|tpl)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.html",
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "markdownIniFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:ini|conf)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.ini",
      "patterns": [
        {
          "include": "source.ini"
        }
      ]
    },
    "markdownLuaFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:lua)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.lua",
      "patterns": [
        {
          "include": "source.lua"
        }
      ]
    },
    "markdownMakefileFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:Makefile|makefile|GNUmakefile|OCamlMakefile)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.makefile",
      "patterns": [
        {
          "include": "source.makefile"
        }
      ]
    },
    "markdownPerlFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:perl|pl|pm|pod|t|PL|psgi|vcl)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.perl",
      "patterns": [
        {
          "include": "source.perl"
        }
      ]
    },
    "markdownRFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:R|r|s|S|Rprofile)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.r",
      "patterns": [
        {
          "include": "source.r"
        }
      ]
    },
    "markdownRubyFencedCode": {
      "name": "markup.fenced_code.block.markdown.gauge",
      "begin": "(?i)^((?:`{3,}|~{3,})\\s*(?:ruby|rb|rbx|rjs|Rakefile|rake|cgi|fcgi|gemspec|irbrc|Capfile|ru|prawn|Cheffile|Gemfile|Guardfile|Hobofile|Vagrantfile|Appraisals|Rantfile|Berksfile|Berksfile.lock|Thorfile|Puppetfile)(?:\\s+[^`~]*)?\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.raw.markdown.gauge"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "contentName": "meta.embedded.block.ruby",
      "patterns": [
        {
          "include": "source.ruby"
        }
      ]
