{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gauge",
  "scopeName": "source.gauge",
  "patterns": [
    {
      "name": "markup.heading.specification.gauge",
      "match": "^\\s*#[^#].*$"
    },
    {
      "name": "markup.heading.scenario.gauge",
      "match": "^\\s*##[^#].*$"
    },
    {
      "name": "keyword.control.tags.gauge",
      "match": "^\\s*tags\\s*:.*$"
    },
    {
      "name": "comment.line.double-slash.gauge",
      "match": "^\\s*//.*$"
    },
    {
      "name": "keyword.operator.step.gauge",
      "match": "^\\s*\\*"
    },
    {
      "name": "string.quoted.dynamic-parameter.gauge",
      "match": "<[^>]+>"
    },
    {
      "name": "markup.table.gauge",
      "match": "^\\s*\\|.*\\|\\s*$"
    }
  ]
}
